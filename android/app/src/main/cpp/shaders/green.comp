#version 450
#extension GL_GOOGLE_include_directive : require
#ifdef HQ_FP16
// 16-bit variant (GPUs with shaderFloat16): shared tiles and the demosaic /
// filter arithmetic in half precision — half the shared memory and faster
// ALU on mobile GPUs. Values are 0..~1 linear light from 10-bit data (fp16
// keeps 11 significant bits at every level); the detail is still computed and
// stored as the difference against the quad green in 32-bit.
#extension GL_EXT_shader_explicit_arithmetic_types_float16 : require
#define HF float16_t
#else
#define HF float
#endif
// HQ (oversampled) luma detail, computed per 32x16-quad tile in shared memory.
//
// The quad image keeps one green per 2x2 site (the mean of Gr and Gb), which
// throws away about half of the sensor's luma resolution. This pass:
//   1. loads the tile's raw pixels (+ borders) once into shared memory as whole
//      RAW10 groups (2 word reads per 4 px), with black level, lens shading
//      and white balance applied (shading interpolated per pixel between the
//      map values at the loaded region's four corners);
//   2. reconstructs green at every raw pixel with edge-directed
//      (Hamilton-Adams) interpolation (green photosites are copied while
//      loading, so only the red/blue half is interpolated);
//   3. applies the anti-alias downscale filter separably (8 taps per axis at
//      the pixel positions around each quad centre) — the discrete form of the
//      5x5 kernel tuned in gpu_pipeline_test (passband vs moire, Lanczos-2
//      level negative lobe);
//   4. writes D = G_hq - G_quad at quad resolution. The render pass samples D
//      with 5 taps. (Sharpening stays in render: folding it in here needed a
//      one-quad tile border that cost more on the phone GPU than it saved.)
// 32x16-quad tiles (256 threads, two output columns each): the halo each tile
// must also load and demosaic is shared by a wide tile (raw loaded 1.72x the
// output, green 1.41x; 16x16 tiles: 2.06x / 1.56x, 8x8: 3.5x / 2.25x), which
// was most of this pass's cost. 32x16 measured 1.4 ms faster than 16x16 on
// the phone (0.14.0 GPU A/B Test, 60 fps).
layout(local_size_x = 16, local_size_y = 16) in;

#include "frame_params.glsl"

layout(std430, set = 0, binding = 1) readonly buffer RawBuffer { uint words[]; } raw;
layout(std430, set = 0, binding = 2) readonly buffer Shading { float gains[]; } shading; // [row][col][R, Geven, Godd, B]
#ifdef GREEN_RGBA16F
layout(set = 0, binding = 3, rgba16f) uniform writeonly image2D detailImage; // fallback: R16F storage unsupported
#else
layout(set = 0, binding = 3, r16f) uniform writeonly image2D detailImage;
#endif
layout(set = 0, binding = 4, rgba16f) uniform readonly image2D quadImage;

// Tile: 32x16 quads = 64x32 raw px. Filter reach +-3.5 px -> green needed for
// px -4..67 x -4..35 (72x40); Hamilton-Adams reach +-2 px -> raw rows -6..37
// (44) and raw columns -8..71 (80: whole RAW10 groups, so loads start on a group).
const int QX = 32;                                     // quads per tile row (Q per column)
const int Q = 16, T = 2 * Q, TX = 2 * QX;
const int GB = 4, GN = T + 2 * GB, GNX = TX + 2 * GB; // green: rows -4..35 (40), cols -4..67 (72)
const int RBX = 8, RNX = TX + 2 * RBX;  // raw cols: -8..71 (80)
const int RBY = 6, RNY = T + 2 * RBY;   // raw rows: -6..37 (44)
const int NT = Q * Q;
shared HF sRaw[RNX * RNY];           // 3520; later reused for row-filter results (GN x QX = 1280)
shared HF sGreen[GNX * GN];          // 2880
// Lens shading (0.13.3): the map at the four corners of the loaded region
// (tile + halo), interpolated for every pixel, so it matches the quad image's
// smooth shading. Exact while the region lies inside one map cell (~125 px
// on the phone), a fraction of a percent off where a cell boundary crosses
// it; no per-pixel memory reads (+0.1 ms on the phone). Before, one value per
// 32x32 block mismatched the quad image by up to the map's gradient over
// 16 px, which leaked into the detail (D = HQ - quad green) near strong edges
// towards the corners.
shared vec4 sCorner[4];
shared vec2 sCornerOrg, sCornerSpan;
#ifdef HQ_EXACT_SHADING
// Reference for the GPU test only (+3.2 ms on the phone): every raw pixel
// shaded exactly as the map interpolates at its own position, from the map
// nodes covering the tile and its halo (map cells are ~125 px on the phone:
// 2x2 cells, 3x3 nodes; up to 4x4 cached, else read from the buffer).
const int kNodes = 4;
shared vec4 sNode[kNodes * kNodes];
shared ivec2 sNode0;
shared int sNodeOk;
#endif

const HF K[8] = HF[8](HF(-0.024), HF(-0.056), HF(0.153), HF(0.427), HF(0.427), HF(0.153), HF(-0.056), HF(-0.024));

uint rawByte(uint offset) {
    return (raw.words[offset >> 2] >> ((offset & 3u) * 8u)) & 0xFFu;
}

int cfaSite(int px, int py) {
    int bit = (py << 1) | px;
    int p = P.rawInfo.w;
    if (p == 0) return bit;
    if (p == 1) return bit ^ 1;
    if (p == 2) return bit ^ 2;
    return 3 - bit;
}

vec4 shadingAt(vec2 rawPos) {
    int cols = P.quadInfo.z, rows = P.quadInfo.w;
    if (cols < 2 || rows < 2) return vec4(1.0);
    vec2 g = clamp(rawToArray(rawPos) / P.arrayInfo.xy * vec2(cols - 1, rows - 1), vec2(0.0), vec2(cols - 1, rows - 1));
    ivec2 i0 = min(ivec2(g), ivec2(cols - 2, rows - 2));
    vec2 f = g - vec2(i0);
    vec4 s[4];
    for (int k = 0; k < 4; ++k) {
        int idx = ((i0.y + (k >> 1)) * cols + (i0.x + (k & 1))) * 4;
        s[k] = vec4(shading.gains[idx], shading.gains[idx + 1], shading.gains[idx + 2], shading.gains[idx + 3]);
    }
    return mix(mix(s[0], s[1], f.x), mix(s[2], s[3], f.x), f.y);
}


#ifdef HQ_PROBE
// GPU benchmark probe (HQ_PROBE 1: stop after loading the raw tile, 2: after
// the demosaic): a partial run whose cost shows where the pass spends its
// time. Its output is overwritten by the real HQ pass that follows.
void probeStore(ivec2 tile, int lid) {
    ivec2 q = tile * ivec2(QX, Q) + ivec2(gl_LocalInvocationID.xy);
    if (q.x < P.quadInfo.x && q.y < P.quadInfo.y)
        imageStore(detailImage, q, vec4(float(sRaw[lid]) + float(sGreen[lid]), 0.0, 0.0, 0.0));
}
#endif

#ifdef HQ_EXACT_SHADING
vec4 mapNode(int c, int r) {
    int idx = (r * P.quadInfo.z + c) * 4;
    return vec4(shading.gains[idx], shading.gains[idx + 1], shading.gains[idx + 2], shading.gains[idx + 3]);
}
// Map position (in nodes) of a raw position, as shadingAt computes it.
vec2 mapPos(vec2 rawPos) {
    int cols = P.quadInfo.z, rows = P.quadInfo.w;
    return clamp(rawToArray(rawPos) / P.arrayInfo.xy * vec2(cols - 1, rows - 1), vec2(0.0), vec2(cols - 1, rows - 1));
}
// shadingAt(rawPos), with the four nodes from the tile's cache when it holds them.
vec4 shadingExact(vec2 rawPos) {
    int cols = P.quadInfo.z, rows = P.quadInfo.w;
    if (cols < 2 || rows < 2) return vec4(1.0);
    vec2 g = mapPos(rawPos);
    ivec2 i0 = min(ivec2(g), ivec2(cols - 2, rows - 2));
    vec2 f = g - vec2(i0);
    vec4 s[4];
    ivec2 c = i0 - sNode0;
    if (sNodeOk != 0 && all(greaterThanEqual(c, ivec2(0))) && all(lessThan(c, ivec2(kNodes - 1)))) {
        for (int k = 0; k < 4; ++k) s[k] = sNode[(c.y + (k >> 1)) * kNodes + c.x + (k & 1)];
    } else {
        for (int k = 0; k < 4; ++k) s[k] = mapNode(i0.x + (k & 1), i0.y + (k >> 1));
    }
    return mix(mix(s[0], s[1], f.x), mix(s[2], s[3], f.x), f.y);
}
#endif

HF R(int x, int y) { return sRaw[(y + RBY) * RNX + (x + RBX)]; } // tile-relative raw px
HF G(int x, int y) { return sGreen[(y + GB) * GNX + (x + GB)]; } // tile-relative green

void main() {
    const ivec2 tile = ivec2(gl_WorkGroupID.xy);
    const ivec2 org = tile * ivec2(TX, T);          // tile origin, raw px (multiple of 32)
    const int lid = int(gl_LocalInvocationIndex);   // 0..255
#ifdef HQ_EXACT_SHADING
    if (lid == 0) {
        // Nodes for every pixel the tile loads (clamped to the frame, like the loads).
        int cols = P.quadInfo.z, rows = P.quadInfo.w;
        sNodeOk = 0;
        if (cols >= 2 && rows >= 2) {
            vec2 lo = clamp(vec2(org - ivec2(RBX, RBY)), vec2(0.0), vec2(P.rawInfo.xy - 1)) + 0.5;
            vec2 hi = clamp(vec2(org + ivec2(TX + RBX - 1, T + RBY - 1)), vec2(0.0), vec2(P.rawInfo.xy - 1)) + 0.5;
            // The array mapping may flip an axis: take the node range over all four corners.
            ivec2 a = min(ivec2(mapPos(lo)), ivec2(cols - 2, rows - 2)), b = min(ivec2(mapPos(hi)), ivec2(cols - 2, rows - 2));
            ivec2 c = min(ivec2(mapPos(vec2(lo.x, hi.y))), ivec2(cols - 2, rows - 2)), d = min(ivec2(mapPos(vec2(hi.x, lo.y))), ivec2(cols - 2, rows - 2));
            ivec2 n0 = min(min(a, b), min(c, d)), n1 = max(max(a, b), max(c, d)) + 1;
            sNode0 = n0;
            if (all(lessThan(n1 - n0, ivec2(kNodes)))) {
                for (int r = n0.y; r <= n1.y; ++r)
                    for (int col = n0.x; col <= n1.x; ++col) sNode[(r - n0.y) * kNodes + (col - n0.x)] = mapNode(col, r);
                sNodeOk = 1;
            }
        }
    }
#else
    if (lid < 4) {
        vec2 lo = clamp(vec2(org - ivec2(RBX, RBY)), vec2(0.0), vec2(P.rawInfo.xy - 1)) + 0.5;
        vec2 hi = clamp(vec2(org + ivec2(TX + RBX - 1, T + RBY - 1)), vec2(0.0), vec2(P.rawInfo.xy - 1)) + 0.5;
        sCorner[lid] = shadingAt(vec2((lid & 1) != 0 ? hi.x : lo.x, (lid & 2) != 0 ? hi.y : lo.y));
        if (lid == 0) {
            sCornerOrg = lo;
            sCornerSpan = max(hi - lo, vec2(1.0));
        }
    }
#endif
    barrier();
    const int groupsPerRow = (P.rawInfo.x + 3) / 4;

    // 1. Raw -> shared, one RAW10 group (4 px, 5 bytes = 2 word reads) per step.
    //    Clamping whole groups / rows at the frame edge keeps the CFA parity
    //    in x; the y clamp only affects the outermost rows.
    for (int i = lid; i < (RNX / 4) * RNY; i += NT) {
        int gx = i % (RNX / 4), row = i / (RNX / 4);
        int grp = clamp((org.x - RBX) / 4 + gx, 0, groupsPerRow - 1);
        int y = clamp(org.y - RBY + row, 0, P.rawInfo.y - 1);
        uint base = uint(y * P.rawInfo.z + grp * 5);
        uint w0 = raw.words[base >> 2], w1 = raw.words[(base >> 2) + 1u];
        uint sh8 = (base & 3u) * 8u;
        // 5 bytes starting at `base`, from the two words.
        uint lo = sh8 == 0u ? w0 : ((w0 >> sh8) | (w1 << (32u - sh8)));
        uint b4 = (sh8 == 0u ? w1 : (w1 >> sh8)) & 0xFFu;
        int ay = y;
        // Tile-relative position this value stands for (the clamped frame-edge
        // copies keep their nominal CFA site, as step 2 sees them).
        const int ry = row - RBY;
        const bool greenRow = ry >= -GB && ry < T + GB;
        for (int b = 0; b < 4; ++b) {
#ifdef HQ_EXACT_SHADING
            const vec4 sh = shadingExact(vec2(grp * 4 + b, y) + 0.5); // the pixel actually loaded
#else
            const vec2 sf = clamp((vec2(grp * 4 + b, y) + 0.5 - sCornerOrg) / sCornerSpan, vec2(0.0), vec2(1.0));
            const vec4 sh = mix(mix(sCorner[0], sCorner[1], sf.x), mix(sCorner[2], sCorner[3], sf.x), sf.y);
#endif
            float dn = float((((lo >> (8u * uint(b))) & 0xFFu) << 2) | ((b4 >> (2 * b)) & 3u));
            int x = grp * 4 + b;
            int site = cfaSite(x & 1, ay & 1);
            float bl = P.blackLevel[site];
            float v = (dn - bl) / (P.wbGains.w - bl);
            float gain = site == 0 ? sh.x * P.wbGains.r
                       : (site == 3 ? sh.w * P.wbGains.b : ((ay & 1) == 0 ? sh.y : sh.z) * P.wbGains.g);
            HF val = HF(v * gain);
            sRaw[row * RNX + gx * 4 + b] = val;
            // Green photosites are their own full-res green: store them now, so
            // step 2 only has to interpolate the red/blue sites.
            const int rx = gx * 4 + b - RBX;
            const int ns = cfaSite(rx & 1, ry & 1);
            if (greenRow && rx >= -GB && rx < TX + GB && (ns == 1 || ns == 2))
                sGreen[(ry + GB) * GNX + (rx + GB)] = val;
        }
    }
    barrier();
#if defined(HQ_PROBE) && HQ_PROBE == 1
    probeStore(tile, lid);
    return;
#endif

    // 2. Full-resolution green (Hamilton-Adams) over the filter support.
    // Only the red/blue half of the sites: every thread runs the same
    // interpolation (no idle lanes waiting on neighbours that just copy).
    for (int i = lid; i < GNX * GN / 2; i += NT) {
        int y = i / (GNX / 2) - GB;
        int x = 2 * (i % (GNX / 2)) - GB;
        int s0 = cfaSite(0, y & 1);           // org is even: tile-relative parity is the CFA parity
        x += (s0 == 1 || s0 == 2) ? 1 : 0;    // the row's non-green column parity
        HF c = R(x, y);
        HF gl = R(x - 1, y), gr = R(x + 1, y), gu = R(x, y - 1), gd = R(x, y + 1);
        HF lapH = HF(2.0) * c - R(x - 2, y) - R(x + 2, y);
        HF lapV = HF(2.0) * c - R(x, y - 2) - R(x, y + 2);
        HF dH = abs(gl - gr) + abs(lapH);
        HF dV = abs(gu - gd) + abs(lapV);
        HF gH = HF(0.5) * (gl + gr) + HF(0.25) * lapH;
        HF gV = HF(0.5) * (gu + gd) + HF(0.25) * lapV;
        HF g = dH < dV ? gH : (dV < dH ? gV : HF(0.5) * (gH + gV));
        HF lo = min(min(gl, gr), min(gu, gd)), hi = max(max(gl, gr), max(gu, gd));
        g = clamp(g, lo, hi); // no overshoot: edges stay halo-free
        sGreen[(y + GB) * GNX + (x + GB)] = g;
    }
    barrier();
#if defined(HQ_PROBE) && HQ_PROBE == 2
    probeStore(tile, lid);
    return;
#endif

    // 3a. Horizontal filter: quad column qx covers px 2qx, 2qx+1; taps at px 2qx-3 .. 2qx+4.
    for (int i = lid; i < GN * QX; i += NT) {
        int row = i / QX, qx = i % QX;
        HF acc = HF(0.0);
        for (int k = 0; k < 8; ++k) acc += K[k] * sGreen[row * GNX + (2 * qx - 3 + k + GB)];
        sRaw[i] = acc; // raw data is no longer needed
    }
    barrier();

    // 3b. Vertical filter + 4. detail against the quad image.
    ivec2 lq = ivec2(gl_LocalInvocationID.xy);
    for (int cx = lq.x; cx < QX; cx += Q) {
        ivec2 q = tile * ivec2(QX, Q) + ivec2(cx, lq.y);
        if (q.x >= P.quadInfo.x || q.y >= P.quadInfo.y) continue;
        HF hqh = HF(0.0);
        for (int k = 0; k < 8; ++k) hqh += K[k] * sRaw[(2 * lq.y - 3 + k + GB) * QX + cx];
        float hq = float(hqh);
        float gq = imageLoad(quadImage, q).g;
        imageStore(detailImage, q, vec4(hq - gq, 0.0, 0.0, 0.0));
    }
}
