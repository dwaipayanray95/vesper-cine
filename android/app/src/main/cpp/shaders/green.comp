#version 450
#extension GL_GOOGLE_include_directive : require
// HQ (oversampled) luma detail, computed per 8x8-quad tile in shared memory.
//
// The quad image keeps one green per 2x2 site (the mean of Gr and Gb), which
// throws away about half of the sensor's luma resolution. This pass:
//   1. loads the tile's raw pixels (+ borders) once into shared memory as whole
//      RAW10 groups (2 word reads per 4 px), with black level, lens shading
//      and white balance applied (shading evaluated once per tile: the map
//      varies over hundreds of pixels);
//   2. reconstructs green at every raw pixel with edge-directed
//      (Hamilton-Adams) interpolation;
//   3. applies the anti-alias downscale filter separably (8 taps per axis at
//      the pixel positions around each quad centre) — the discrete form of the
//      5x5 kernel tuned in gpu_pipeline_test (passband vs moire, Lanczos-2
//      level negative lobe);
//   4. optional sharpening (P.flags.w & 15) on that oversampled green, so the
//      render pass doesn't need its own 9-tap unsharp mask when HQ is on;
//   5. writes D = G_hq(+sharpening) - G_quad at quad resolution. The render
//      pass samples D with 5 taps.
// 64 threads: good occupancy on mobile GPUs (PowerVR / Mali / Adreno).
layout(local_size_x = 8, local_size_y = 8) in;

#include "frame_params.glsl"

layout(std430, set = 0, binding = 1) readonly buffer RawBuffer { uint words[]; } raw;
layout(std430, set = 0, binding = 2) readonly buffer Shading { float gains[]; } shading; // [row][col][R, Geven, Godd, B]
#ifdef GREEN_RGBA16F
layout(set = 0, binding = 3, rgba16f) uniform writeonly image2D detailImage; // fallback: R16F storage unsupported
#else
layout(set = 0, binding = 3, r16f) uniform writeonly image2D detailImage;
#endif
layout(set = 0, binding = 4, rgba16f) uniform readonly image2D quadImage;

// Tile: 8x8 quads = 16x16 raw px, plus one quad of border for the sharpening
// blur -> HQ green needed for 10x10 quads = px -2..17 (quad-aligned: -2..18).
// Filter reach +-3.5 px -> green needed for px -6..21 (28x28);
// Hamilton-Adams reach +-2 px -> raw px -8..23 (32x32, starts on a RAW10 group).
const int Q = 8, T = 2 * Q;
const int GB = 6, GN = T + 2 * GB;      // green: px -6..21 (28)
const int RB = 8, RN = T + 2 * RB;      // raw:   px -8..23 (32)
const int HQN = Q + 2;                  // HQ quads incl. 1-quad border (10)
const int NT = Q * Q;
shared float sRaw[RN * RN];             // 1024; later reused for row-filter results (GN x HQN = 280)
shared float sGreen[GN * GN];           // 784
shared float sHq[HQN * HQN];            // 100

const float K[8] = float[8](-0.024, -0.056, 0.153, 0.427, 0.427, 0.153, -0.056, -0.024);

uint rawByte(uint offset) {
    return (raw.words[offset >> 2] >> ((offset & 3u) * 8u)) & 0xFFu;
}

int cfaSite(int px, int py) {
    int bit = (py << 1) | px;
    int p = P.rawInfo.w;
    if (p == 0) return bit;
    if (p == 1) return bit ^ 1;
    if (p == 2) return bit ^ 2;
    return 3 - bit;
}

vec4 shadingAt(vec2 rawPos) {
    int cols = P.quadInfo.z, rows = P.quadInfo.w;
    if (cols < 2 || rows < 2) return vec4(1.0);
    vec2 g = clamp(rawToArray(rawPos) / P.arrayInfo.xy * vec2(cols - 1, rows - 1), vec2(0.0), vec2(cols - 1, rows - 1));
    ivec2 i0 = min(ivec2(g), ivec2(cols - 2, rows - 2));
    vec2 f = g - vec2(i0);
    vec4 s[4];
    for (int k = 0; k < 4; ++k) {
        int idx = ((i0.y + (k >> 1)) * cols + (i0.x + (k & 1))) * 4;
        s[k] = vec4(shading.gains[idx], shading.gains[idx + 1], shading.gains[idx + 2], shading.gains[idx + 3]);
    }
    return mix(mix(s[0], s[1], f.x), mix(s[2], s[3], f.x), f.y);
}

float R(int x, int y) { return sRaw[(y + RB) * RN + (x + RB)]; }   // tile-relative raw px
float G(int x, int y) { return sGreen[(y + GB) * GN + (x + GB)]; } // tile-relative green

void main() {
    const ivec2 tile = ivec2(gl_WorkGroupID.xy);
    const ivec2 org = tile * T;                     // tile origin, raw px (multiple of 16)
    const int lid = int(gl_LocalInvocationIndex);   // 0..63
    const vec4 sh = shadingAt(vec2(org) + vec2(T * 0.5));
    const int groupsPerRow = (P.rawInfo.x + 3) / 4;

    // 1. Raw -> shared, one RAW10 group (4 px, 5 bytes = 2 word reads) per step.
    //    Clamping whole groups / rows at the frame edge keeps the CFA parity
    //    in x; the y clamp only affects the outermost rows.
    for (int i = lid; i < (RN / 4) * RN; i += NT) {
        int gx = i % (RN / 4), row = i / (RN / 4);
        int grp = clamp((org.x - RB) / 4 + gx, 0, groupsPerRow - 1);
        int y = clamp(org.y - RB + row, 0, P.rawInfo.y - 1);
        uint base = uint(y * P.rawInfo.z + grp * 5);
        uint w0 = raw.words[base >> 2], w1 = raw.words[(base >> 2) + 1u];
        uint sh8 = (base & 3u) * 8u;
        // 5 bytes starting at `base`, from the two words.
        uint lo = sh8 == 0u ? w0 : ((w0 >> sh8) | (w1 << (32u - sh8)));
        uint b4 = (sh8 == 0u ? w1 : (w1 >> sh8)) & 0xFFu;
        int ay = y;
        for (int b = 0; b < 4; ++b) {
            int x = grp * 4 + b;
            float dn = float((((lo >> (8u * uint(b))) & 0xFFu) << 2) | ((b4 >> (2 * b)) & 3u));
            int site = cfaSite(x & 1, ay & 1);
            float bl = P.blackLevel[site];
            float v = (dn - bl) / (P.wbGains.w - bl);
            float gain = site == 0 ? sh.x * P.wbGains.r
                       : (site == 3 ? sh.w * P.wbGains.b : ((ay & 1) == 0 ? sh.y : sh.z) * P.wbGains.g);
            sRaw[row * RN + gx * 4 + b] = v * gain;
        }
    }
    barrier();

    // 2. Full-resolution green (Hamilton-Adams) over the filter support.
    for (int i = lid; i < GN * GN; i += NT) {
        int x = i % GN - GB, y = i / GN - GB;
        int site = cfaSite((org.x + x) & 1, (org.y + y) & 1);
        float g;
        if (site == 1 || site == 2) {
            g = R(x, y);
        } else {
            float c = R(x, y);
            float gl = R(x - 1, y), gr = R(x + 1, y), gu = R(x, y - 1), gd = R(x, y + 1);
            float lapH = 2.0 * c - R(x - 2, y) - R(x + 2, y);
            float lapV = 2.0 * c - R(x, y - 2) - R(x, y + 2);
            float dH = abs(gl - gr) + abs(lapH);
            float dV = abs(gu - gd) + abs(lapV);
            float gH = 0.5 * (gl + gr) + 0.25 * lapH;
            float gV = 0.5 * (gu + gd) + 0.25 * lapV;
            g = dH < dV ? gH : (dV < dH ? gV : 0.5 * (gH + gV));
            float lo = min(min(gl, gr), min(gu, gd)), hi = max(max(gl, gr), max(gu, gd));
            g = clamp(g, lo, hi); // no overshoot: edges stay halo-free
        }
        sGreen[i] = g;
    }
    barrier();

    // 3a. Horizontal filter for HQ quad columns -1..8: quad qx covers px 2qx, 2qx+1;
    //     taps at px 2qx-3 .. 2qx+4.
    for (int i = lid; i < GN * HQN; i += NT) {
        int row = i / HQN, qx = i % HQN - 1;
        float acc = 0.0;
        for (int k = 0; k < 8; ++k) acc += K[k] * sGreen[row * GN + (2 * qx - 3 + k + GB)];
        sRaw[i] = acc; // raw data is no longer needed
    }
    barrier();
    // 3b. Vertical filter for HQ quads (-1..8)^2.
    for (int i = lid; i < HQN * HQN; i += NT) {
        int qx = i % HQN, qy = i / HQN - 1;
        float acc = 0.0;
        for (int k = 0; k < 8; ++k) acc += K[k] * sRaw[(2 * qy - 3 + k + GB) * HQN + qx];
        sHq[i] = acc;
    }
    barrier();

    ivec2 lq = ivec2(gl_LocalInvocationID.xy);
    ivec2 q = tile * Q + lq;
    if (q.x >= P.quadInfo.x || q.y >= P.quadInfo.y) return;
    float hq = sHq[(lq.y + 1) * HQN + lq.x + 1];

    // 4. Sharpening on the oversampled green (same strength and noise coring
    //    as the quad path's sharpen() in render.comp, which is skipped with HQ).
    int level = P.flags.w & 15;
    if (level > 0) {
        float blur = 0.0;
        for (int j = -1; j <= 1; ++j)
            for (int i = -1; i <= 1; ++i)
                blur += (i == 0 ? 2.0 : 1.0) * (j == 0 ? 2.0 : 1.0) * sHq[(lq.y + 1 + j) * HQN + lq.x + 1 + i];
        blur /= 16.0;
        float detail = hq - blur;
        // Noise of (hq - blur): the oversampled green averages ~4 photosites, so
        // its noise is about half the quad's (0.6 there -> 0.3 here).
        float sigma = sqrt(max(P.noise.z * max(blur, 0.0) + P.noise.w, 1e-9)) * 0.3;
        float cored = sign(detail) * max(abs(detail) - 2.0 * sigma, 0.0);
        // 1.5x the quad path's amounts: the oversampled green is already crisper,
        // so the same visible strength per level needs a little more gain.
        float amount = level == 1 ? 0.6 : (level == 2 ? 1.2 : 1.95);
        hq += amount * cored;
    }

    float gq = imageLoad(quadImage, q).g;
    imageStore(detailImage, q, vec4(hq - gq, 0.0, 0.0, 0.0));
}
