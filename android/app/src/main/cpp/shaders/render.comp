#version 450
#extension GL_GOOGLE_include_directive : require
// Pass 2: quad image -> upright, cropped, resampled output.
//
// One invocation renders a 2x2 block of output pixels so it can also emit the
// block's 4:2:0 chroma sample for the encoder (P010, BT.2020 limited range).
//   camera RGB -> scene-linear Rec.2020 (DNG forward matrix, Bradford D50->D65)
//              -> Apple Log  (recording master)
//              -> Rec.709 display transform + monitoring overlays (viewfinder)
// Workgroup size: 8x8 normally; RENDER_WG_X/Y variants are benchmark experiments.
#ifndef RENDER_WG_X
#define RENDER_WG_X 8
#define RENDER_WG_Y 8
#endif
layout(local_size_x = RENDER_WG_X, local_size_y = RENDER_WG_Y) in;

#include "frame_params.glsl"

layout(set = 0, binding = 1) uniform sampler2D quadTex;
layout(set = 0, binding = 2, rgba8) uniform writeonly image2D viewfinder;
layout(std430, set = 0, binding = 3) writeonly buffer P010 { uint words[]; } p010;
layout(set = 0, binding = 4) uniform sampler2D greenTex;   // HQ luma detail per quad (green.comp)
layout(set = 0, binding = 5) uniform sampler2D quadRawTex; // quad image before noise reduction

// Apple Log (Apple Log Profile White Paper, 2023). C1-continuous at Rt.
float appleLog(float x) {
    const float R0 = -0.05641088, Rt = 0.01, c = 47.28711236;
    const float beta = 0.00964052, gamma = 0.08550479, delta = 0.69336945;
    if (x >= Rt) return gamma * log2(x + beta) + delta;
    if (x >= R0) return c * (x - R0) * (x - R0);
    return 0.0;
}

vec3 toRec2020(vec3 cam) {
    return vec3(dot(P.camToRec2020[0].xyz, cam), dot(P.camToRec2020[1].xyz, cam), dot(P.camToRec2020[2].xyz, cam));
}

// Monitoring display transform: Rec.2020 scene-linear -> Rec.709 gamut ->
// filmic tone curve (Narkowicz ACES fit, grey lands at ~0.49 sRGB) -> sRGB.
// color_science/generate_applelog_lut.py builds the matching .cube.
vec3 displayRec709(vec3 lin2020) {
    const mat3 rec2020To709 = mat3(1.6605, -0.1246, -0.0182,
                                   -0.5876, 1.1329, -0.1006,
                                   -0.0728, -0.0083, 1.1187);
    vec3 x = max(rec2020To709 * lin2020, vec3(0.0)) * 0.8;
    vec3 t = clamp((x * (2.51 * x + 0.03)) / (x * (2.43 * x + 0.59) + 0.14), 0.0, 1.0);
    return mix(t * 12.92, 1.055 * pow(t, vec3(1.0 / 2.4)) - 0.055, step(0.0031308, t));
}

vec3 falseColor(float stops, bool clipped, vec3 display) {
    float headroom = P.exposure.w;
    if (clipped || stops >= headroom - 0.1) return vec3(1.0, 0.0, 0.0);   // clipped
    if (stops >= headroom - 0.6) return vec3(1.0, 0.9, 0.0);              // last half stop before clip
    if (stops >= 0.75 && stops <= 1.25) return vec3(1.0, 0.45, 0.7);      // skin (+1 stop)
    if (abs(stops) <= 0.2) return vec3(0.2, 0.85, 0.2);                   // 18% grey
    if (stops <= -4.5) return vec3(0.45, 0.0, 0.6);                       // near noise floor
    if (stops <= -3.5) return vec3(0.1, 0.3, 1.0);                        // deep shadow
    return vec3(dot(display, vec3(0.2126, 0.7152, 0.0722)));
}

// Output pixel -> continuous raw-sensor coordinate (pixel centres at +0.5).
vec2 rawPosFor(ivec2 o) {
    ivec2 od = P.outInfo.xy;
    int rot = P.outInfo.z;
    vec2 u, ud;
    vec2 c = vec2(o) + 0.5;
    if (rot == 90)       { ud = vec2(od.y, od.x); u = vec2(c.y, float(od.x) - c.x); }
    else if (rot == 180) { ud = vec2(od);         u = vec2(float(od.x) - c.x, float(od.y) - c.y); }
    else if (rot == 270) { ud = vec2(od.y, od.x); u = vec2(float(od.y) - c.y, c.x); }
    else                 { ud = vec2(od);         u = c; }
    return P.cropRect.xy + u * P.cropRect.zw / ud;
}

// Undistorted (ideal) raw position -> where that ray actually landed on the
// sensor, using the Camera2 lens model (ACAMERA_LENS_DISTORTION: Brown-Conrady
// radial k1..k3 + tangential p1, p2 about the calibrated optical centre).
vec2 distort(vec2 rawPos) {
    if (P.lensK.w == 0.0) return rawPos;
    vec2 p = (rawToArray(rawPos) - P.lensF.zw) / P.lensF.xy;
    float r2 = dot(p, p);
    float radial = 1.0 + r2 * (P.lensK.x + r2 * (P.lensK.y + r2 * P.lensK.z));
    vec2 d = p * radial + vec2(2.0 * P.lensP.x * p.x * p.y + P.lensP.y * (r2 + 2.0 * p.x * p.x),
                               P.lensP.x * (r2 + 2.0 * p.y * p.y) + 2.0 * P.lensP.y * p.x * p.y);
    return arrayToRaw(d * P.lensF.xy + P.lensF.zw);
}

// Quad texel q holds a channel sampled at raw position 2q + offset.
vec2 quadUv(vec2 rawPos, vec2 offset) {
    return ((rawPos - offset) * 0.5 + 0.5) / vec2(P.quadInfo.xy);
}

// Catmull-Rom (bicubic) resample of the quad image in 5 bilinear taps
// (Jimenez's optimisation; the 4 corner taps carry negligible weight). Much
// crisper than plain bilinear, which softened the image by ~half a pixel.
vec4 catmullRom(sampler2D tex, vec2 uv, vec2 size) {
    vec2 pos = uv * size;
    vec2 t1 = floor(pos - 0.5) + 0.5;
    vec2 f = pos - t1;
    vec2 w0 = f * (-0.5 + f * (1.0 - 0.5 * f));
    vec2 w1 = 1.0 + f * f * (-2.5 + 1.5 * f);
    vec2 w2 = f * (0.5 + f * (2.0 - 1.5 * f));
    vec2 w3 = f * f * (-0.5 + 0.5 * f);
    vec2 w12 = w1 + w2;
    vec2 t0 = (t1 - 1.0) / size, t3 = (t1 + 2.0) / size, t12 = (t1 + w2 / w12) / size;
    vec4 c = texture(tex, vec2(t12.x, t0.y)) * (w12.x * w0.y)
           + texture(tex, vec2(t0.x, t12.y)) * (w0.x * w12.y)
           + texture(tex, t12) * (w12.x * w12.y)
           + texture(tex, vec2(t3.x, t12.y)) * (w3.x * w12.y)
           + texture(tex, vec2(t12.x, t3.y)) * (w12.x * w3.y);
    return c / (w12.x * w0.y + w0.x * w12.y + w12.x * w12.y + w3.x * w12.y + w12.x * w3.y);
}

vec4 sampleCatmullRom(vec2 uv) { return catmullRom(quadTex, uv, vec2(P.quadInfo.xy)); }

// HQ (oversampled) luma: the green pass stored, per quad, the detail the quad
// path misses (anti-alias-filtered full-resolution green minus quad green,
// before noise reduction). Resample it like the quads and add it to the
// noise-reduced green:  G = G_clean + D. With NR off this is exactly the
// oversampled value; with NR on the detail is cored against the sensor noise
// so NR isn't undone. Applied as a ratio so colour (from the quads) is kept.
vec3 oversampleLuma(vec3 cam, vec2 rawPos, float clipFlag) {
    if ((P.flags.w & 16) == 0 || clipFlag > 0.5) return cam;
    float detail = catmullRom(greenTex, quadUv(rawPos, vec2(1.0)), vec2(P.quadInfo.xy)).r;
    if (P.noise.x > 0.0 || P.noise.y > 0.0) {
        float sigma = sqrt(max(P.noise.z * max(cam.g, 0.0) + P.noise.w, 1e-9)) * 0.5;
        detail = sign(detail) * max(abs(detail) - sigma, 0.0);
    }
    float g = max(cam.g + detail, 0.0);
    return cam * clamp(g / max(cam.g, 1e-5), 0.25, 4.0);
}

vec4 sampleCamera(vec2 rawPos) {
    vec2 guv = quadUv(rawPos, vec2(1.0));
    float g = sampleCatmullRom(guv).g;
    // Chroma: bilinear is enough (the eye resolves colour far less finely than
    // luma) and saves 8 texture reads per pixel.
    float r = texture(quadTex, quadUv(rawPos, P.cfaOffsets.xy)).r;
    float b = texture(quadTex, quadUv(rawPos, P.cfaOffsets.zw)).b;
    float clipFlag = texture(quadTex, guv).a;
    // Bicubic can undershoot next to hard edges; never let it go negative.
    return vec4(max(vec3(r, g, b), vec3(0.0)), clipFlag);
}

// Detail enhancement (P.flags.w: 0 off, 1 low, 2 medium, 3 high): unsharp mask
// on the green (luma) quads, applied multiplicatively to R/G/B so colours
// don't shift. Detail below ~2 sigma of the sensor noise at that level is
// cored out, so it sharpens edges and texture, not noise.
vec3 sharpen(vec3 cam, vec2 rawPos) {
    int level = P.flags.w & 15;
    if (level <= 0) return cam;
    ivec2 qmax = ivec2(P.quadInfo.xy) - 1;
    ivec2 q = ivec2(floor((rawPos - vec2(1.0)) * 0.5 + 0.5));
    vec4 cq = texelFetch(quadTex, clamp(q, ivec2(0), qmax), 0);
    float c = cq.g;
    float shadeGain = cq.a > 0.5 ? 1.0 : max(cq.a * 10.0, 1.0); // corners are amplified (noisier)
    float blur = 0.0;
    // The 3x3 greens from four 2x2 gathers (4 texture reads instead of 9).
    // A gather at the corner shared by texels (x, y) and (x + 1, y + 1) returns
    // them as .w (x, y), .z (x + 1, y), .x (x, y + 1), .y (x + 1, y + 1);
    // clamp-to-edge repeats the border texels exactly like the clamp above.
    vec2 inv = 1.0 / vec2(P.quadInfo.xy);
    vec4 g00 = textureGather(quadTex, vec2(q) * inv, 1);                  // q-1, q
    vec4 g10 = textureGather(quadTex, (vec2(q) + vec2(2.0, 0.0)) * inv, 1); // q+1 column
    vec4 g01 = textureGather(quadTex, (vec2(q) + vec2(0.0, 2.0)) * inv, 1); // q+1 row
    vec4 g11 = textureGather(quadTex, (vec2(q) + vec2(2.0)) * inv, 1);      // q+1, q+1
    float g3[9] = float[9](g00.w, g00.z, g10.w,
                           g00.x, g00.y, g10.x,
                           g01.w, g01.z, g11.w);
    // Same weights and summation order as a plain 3x3 loop.
    for (int j = -1; j <= 1; ++j)
        for (int i = -1; i <= 1; ++i) {
            float w = (i == 0 ? 2.0 : 1.0) * (j == 0 ? 2.0 : 1.0);
            blur += w * g3[(j + 1) * 3 + i + 1];
        }
    blur /= 16.0;
    float detail = c - blur;
    float sigma = shadeGain * sqrt(max(P.noise.z * blur / shadeGain + P.noise.w, 1e-9)) * 0.6; // noise of (c - blur)
    float cored = sign(detail) * max(abs(detail) - 2.0 * sigma, 0.0);
    float amount = level == 1 ? 0.4 : (level == 2 ? 0.8 : 1.3);
    float gain = 1.0 + amount * cored / max(blur, 1e-4);
    return cam * clamp(gain, 0.5, 2.0);
}

// Focus peaking on the demosaiced green quads (texelFetch on the quad grid, so
// no phase-dependent bilinear smoothing -> no moire pattern). A pixel peaks
// only where the image is *sharp*, not merely high-contrast:
//  * fine-scale (Sobel, 1 quad) slope clearly steeper than the coarse slope
//    over +-3 quads (a blurred edge has the same slope at both scales);
//  * slope well above sensor noise at that level (noise profile S/O), so
//    noise in dark or defocused areas never lights up;
//  * a minimum local contrast relative to the mean (sensitivity P.exposure.z).
float greenQuad(ivec2 q) {
    return texelFetch(quadTex, clamp(q, ivec2(0), ivec2(P.quadInfo.xy) - 1), 0).g;
}

vec3 peakingOverlay(vec2 rawPos, vec3 display) {
    ivec2 q = ivec2(floor((rawPos - vec2(1.0)) * 0.5 + 0.5));
    float g[9];
    float mean = 0.0;
    for (int j = -1; j <= 1; ++j)
        for (int i = -1; i <= 1; ++i) {
            float v = greenQuad(q + ivec2(i, j));
            g[(j + 1) * 3 + i + 1] = v;
            mean += v;
        }
    mean /= 9.0;
    float gx = ((g[2] + 2.0 * g[5] + g[8]) - (g[0] + 2.0 * g[3] + g[6])) / 8.0; // slope per quad
    float gy = ((g[6] + 2.0 * g[7] + g[8]) - (g[0] + 2.0 * g[1] + g[2])) / 8.0;
    float fine = length(vec2(gx, gy));
    float cx = (greenQuad(q + ivec2(3, 0)) - greenQuad(q - ivec2(3, 0))) / 6.0;
    float cy = (greenQuad(q + ivec2(0, 3)) - greenQuad(q - ivec2(0, 3))) / 6.0;
    float coarse = length(vec2(cx, cy));
    float sigma = sqrt(max(P.noise.z * mean + P.noise.w, 1e-9)); // single-sample sensor noise
    bool aboveNoise = fine > 2.0 * sigma;
    bool contrast = fine > P.exposure.z * 0.5 * max(mean, 1e-4); // 0.06 -> 3% per quad
    bool sharp = fine - 0.7 * sigma > 1.5 * coarse;
    return aboveNoise && contrast && sharp ? vec3(0.1, 1.0, 0.3) : display;
}

uint pack16(float lo, float hi) {
    return (uint(lo) << 6) | (uint(hi) << 22);
}

void main() {
    ivec2 block = ivec2(gl_GlobalInvocationID.xy);
    ivec2 od = P.outInfo.xy;
    if (block.x * 2 >= od.x || block.y * 2 >= od.y) return;

    vec2 cbcr = vec2(0.0);
    float yCode[4];
    for (int k = 0; k < 4; ++k) {
        ivec2 o = block * 2 + ivec2(k & 1, k >> 1);
        vec2 rawPos = distort(rawPosFor(o));
        vec4 cam = sampleCamera(rawPos);
        cam.rgb = oversampleLuma(cam.rgb, rawPos, cam.a);
        cam.rgb = sharpen(cam.rgb, rawPos);
        vec3 lin = toRec2020(cam.rgb);
        vec3 logv = vec3(appleLog(lin.r), appleLog(lin.g), appleLog(lin.b));

        // BT.2020 non-constant-luminance Y'CbCr, 10-bit limited range.
        float y = dot(logv, vec3(0.2627, 0.6780, 0.0593));
        yCode[k] = clamp(round(64.0 + 876.0 * y), 4.0, 1019.0);
        cbcr += vec2((logv.b - y) / 1.8814, (logv.r - y) / 1.4746);

        if (P.flags.z == 0) continue;
        bool clipped = cam.a > 0.5;
        vec3 display = displayRec709(lin);
        vec3 vf;
        int mode = P.outInfo.w;
        if (mode == 0) {
            vf = clamp(logv, 0.0, 1.0);
        } else if (mode == 2) {
            float lum = dot(lin, vec3(0.2627, 0.6780, 0.0593));
            vf = falseColor(log2(max(lum, 1e-6) / 0.18), clipped, display);
        } else if (mode == 3) {
            vf = peakingOverlay(rawPos, display);
        } else if (mode == 4) {
            bool hot = clipped || max(lin.r, max(lin.g, lin.b)) >= P.exposure.y * P.exposure.x;
            bool stripe = ((o.x + o.y) / 6) % 2 == 0;
            vf = hot ? (stripe ? vec3(0.08) : vec3(1.0)) : display;
        } else {
            vf = display;
        }
        imageStore(viewfinder, o, vec4(P.flags.y != 0 ? vf.bgr : vf, 1.0));
    }

    if (P.flags.x == 0) return;
    // P010: Y plane (16-bit LE, 10 significant bits in the top) then interleaved CbCr.
    int w = od.x;
    uint row0 = uint((block.y * 2) * w + block.x * 2) >> 1;
    uint row1 = uint((block.y * 2 + 1) * w + block.x * 2) >> 1;
    p010.words[row0] = pack16(yCode[0], yCode[1]);
    p010.words[row1] = pack16(yCode[2], yCode[3]);
    cbcr *= 0.25;
    float cb = clamp(round(512.0 + 896.0 * cbcr.x), 4.0, 1019.0);
    float cr = clamp(round(512.0 + 896.0 * cbcr.y), 4.0, 1019.0);
    uint uvBase = uint(w * od.y) >> 1;
    p010.words[uvBase + uint(block.y * (w >> 1) + block.x)] = pack16(cb, cr);
}
